using System;

class Student
{
    public string Name { get; set; }
    public int Grade1 { get; set; }
    public int Grade2 { get; set; }
    public int Grade3 { get; set; }

    public Student(string name, int g1, int g2, int g3)
    {
        Name = name;
        Grade1 = g1;
        Grade2 = g2;
        Grade3 = g3;
    }

    public double GetAverage()
    {
        return (Grade1 + Grade2 + Grade3) / 3.0;
    }

    public string GetLetterGrade()
    {
        double avg = GetAverage();

        if (avg >= 90) return "A";
        if (avg >= 75) return "B";
        if (avg >= 60) return "C";
        return "F";
    }

    public void Print()
    {
        Console.WriteLine($"{Name} | Avg: {GetAverage():F2} | Grade: {GetLetterGrade()}");
    }
}

class Program
{
    static void Main()
    {
        Student[] roster = new Student[]
        {
            new Student("Asylai", 95, 90, 92),
            new Student("Sultan", 78, 82, 74),
            new Student("Dauren", 60, 65, 58),
            new Student("Raikhan", 88, 91, 85)
        };

        foreach (Student s in roster)
        {
            s.Print();
        }

        Student best = roster[0];

        for (int i = 1; i < roster.Length; i++)
        {
            Student s = roster[i];
            if (s.GetAverage() > best.GetAverage())
                best = s;
        }

        Console.WriteLine("\nTop Student:");
        best.Print();
    }
}
